generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  dentist
  staff
  patient
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role
  phone     String?
  patients  Patient[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Patient {
  id             String   @id @default(cuid())
  fullName       String
  fileNumber     String   @unique
  age            Int
  phone          String
  status         String
  medicalHistory String?
  creatorId      String
  creator        User     @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([creatorId])
  @@index([fullName])
}
